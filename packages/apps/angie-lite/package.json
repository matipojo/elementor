{
  "name": "@elementor/angie-lite",
  "description": "Lightweight Angie sidebar loader for Elementor",
  "version": "4.2.0",
  "private": true,
  "author": "Elementor Team",
  "homepage": "https://elementor.com/",
  "license": "GPL-3.0-or-later",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elementor/elementor.git",
    "directory": "packages/apps/angie-lite"
  },
  "bugs": {
    "url": "https://github.com/elementor/elementor/issues"
  },
  "dependencies": {
    "@elementor-external/angie-sdk": "file:../../../../angie-sdk"
  },
  "scripts": {
    "build": "tsup --config=../../tsup.build.ts",
    "dev": "tsup --config=../../tsup.dev.ts"
  },
  "devDependencies": {
    "tsup": "^8.3.5"
  }
}
